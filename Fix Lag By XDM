local function RemoveColorAndVFX(obj)
    pcall(function()
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Highlight") or obj:IsA("Explosion") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Light") or obj:IsA("PostEffect") then
            obj:Destroy()
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Color = Color3.fromRGB(0, 0, 0)
        end
    end)
end

local function CleanPlayer(char)
    if not char or char == LP.Character then return end
    task.delay(0.3, function()
        pcall(function()
            for _, obj in pairs(char:GetDescendants()) do
                RemoveColorAndVFX(obj)
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                local anim = hum:FindFirstChildOfClass("Animator")
                if anim then
                    for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                        track:Stop(0)
                    end
                end
            end
        end)
    end)
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LP then
        if p.Character then CleanPlayer(p.Character) end
        p.CharacterAdded:Connect(CleanPlayer)
    end
end
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(CleanPlayer)
end)

local function OptimizeCharacter(char)
    if not char then return end
    pcall(function()
        for _, v in pairs(char:GetDescendants()) do
            RemoveColorAndVFX(v)
        end
        char.DescendantAdded:Connect(function(v)
            task.spawn(function()
                RemoveColorAndVFX(v)
            end)
        end)
    end)
end

if LP.Character then OptimizeCharacter(LP.Character) end
LP.CharacterAdded:Connect(OptimizeCharacter)

local function ProcessObject(v)
    if not v or not v.Parent then return end
    pcall(function()
        if v == Workspace.CurrentCamera or v.Name == "SafePlatform" then return end
        if LP.Character and v:IsDescendantOf(LP.Character) then return end

        local vName = v.Name:lower()
        
        -- Xóa Thuyền & Mob ngoài biển tự động
        if vName:find("boat") or vName:find("ship") or vName:find("sloop") or vName:find("galleon") or
           vName:find("seabeast") or vName:find("sea beast") or vName:find("terrorshark") or 
           vName:find("terror shark") or vName:find("shark") or vName:find("piranha") or 
           vName:find("seamonster") or vName:find("sea monster") or vName:find("ghost ship") or vName:find("ghostship") then
            v:Destroy()
            return
        end

        local ancestorModel = v:FindFirstAncestorOfClass("Model")
        if ancestorModel then
            local aName = ancestorModel.Name:lower()
            if aName:find("boat") or aName:find("ship") or aName:find("sloop") or aName:find("galleon") or
               aName:find("seabeast") or aName:find("sea beast") or aName:find("terrorshark") or 
               aName:find("terror shark") or aName:find("shark") or aName:find("piranha") or 
               aName:find("seamonster") or aName:find("sea monster") or aName:find("ghost ship") or aName:find("ghostship") then
                ancestorModel:Destroy()
                return
            end
        end

        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Highlight") or v:IsA("Explosion") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Light") then
            v:Destroy()
            return
        end

        local model = v:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") then
            if model ~= LP.Character and not model:IsDescendantOf(LP.Character) then
                for _, desc in pairs(model:GetDescendants()) do
                    if desc:IsA("Animation") then
                        desc:Destroy()
                    end
                end
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum then
                    local anim = hum:FindFirstChildOfClass("Animator")
                    if anim then
                        for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                            track:Stop(0)
                        end
                    end
                end
            end

            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Color = Color3.fromRGB(0, 0, 0)
            elseif v:IsA("Texture") or v:IsA("Decal") then
                v:Destroy()
            end
            return
        end

        if v:IsA("BasePart") and (v:FindFirstChildOfClass("ProximityPrompt") or v:FindFirstChildOfClass("ClickDetector")) then
            v.Material = Enum.Material.SmoothPlastic
            v.Transparency = 0
            v.Color = Color3.fromRGB(0, 255, 100)
            return
        end

        if v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("Texture") or v:IsA("Decal") then
            v:Destroy()
        end
    end)
end

task.spawn(function()
    local descendants = Workspace:GetDescendants()
    local batchSize = 150
    for i = 1, #descendants, batchSize do
        for j = i, math.min(i + batchSize - 1, #descendants) do
            ProcessObject(descendants[j])
        end
        task.wait()
    end
end)

Workspace.DescendantAdded:Connect(function(v)
    task.spawn(function()
        ProcessObject(v)
    end)
end)

local function CreatePlatform(char)
    local root = char:WaitForChild("HumanoidRootPart", 10)
    if root then
        task.wait(0.3)
        pcall(function()
            local old = Workspace:FindFirstChild("SafePlatform")
            if old then old:Destroy() end

            local plat = Instance.new("Part", Workspace)
            plat.Name = "SafePlatform"
            plat.Size = Vector3.new(200, 1, 200)
            plat.CFrame = root.CFrame - Vector3.new(0, 3, 0)
            plat.Anchored = true
            plat.Material = Enum.Material.SmoothPlastic
            plat.Color = Color3.fromRGB(0, 0, 0)
            plat.Transparency = 0.85
        end)
    end
end

if LP.Character then CreatePlatform(LP.Character) end
LP.CharacterAdded:Connect(CreatePlatform)
