local Lighting = game:GetService("Lighting")

-- 1) Xoá sương mù (fog) hoàn toàn, và tự khôi phục nếu game set lại
local function removeFog()
    Lighting.FogEnd = 1e10
    Lighting.FogStart = 1e10
    Lighting.FogColor = Color3.new(1, 1, 1)
end
removeFog()
Lighting:GetPropertyChangedSignal("FogEnd"):Connect(removeFog)
Lighting:GetPropertyChangedSignal("FogStart"):Connect(removeFog)
Lighting:GetPropertyChangedSignal("FogColor"):Connect(removeFog)

-- 2) Fullbright (xoá bóng tối/ánh sáng động)
local function doFullbright()
    Lighting.Ambient = Color3.new(1, 1, 1)
    Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    Lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
    Lighting.ColorShift_Top = Color3.new(1, 1, 1)
    Lighting.Brightness = 2
    Lighting.ClockTime = 14 -- giữ giờ ban ngày cố định, tránh hiệu ứng đêm/hoàng hôn nặng
    Lighting.GlobalShadows = false
    Lighting.ShadowSoftness = 0
end
doFullbright()
Lighting.LightingChanged:Connect(doFullbright)

-- 3) Xoá các PostEffect gây tốn GPU nặng nhất (Bloom, Blur, ColorCorrection, SunRays, DepthOfField)
local function stripPostEffects()
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("BloomEffect")
        or obj:IsA("BlurEffect")
        or obj:IsA("SunRaysEffect")
        or obj:IsA("DepthOfFieldEffect")
        or obj:IsA("ColorCorrectionEffect") then
            pcall(function() obj.Enabled = false end)
        end
    end
end
stripPostEffects()
Lighting.ChildAdded:Connect(function()
    task.wait(0.1)
    stripPostEffects()
end)

-- 4) Thông báo
game.StarterGui:SetCore("SendNotification", {
